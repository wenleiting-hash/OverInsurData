# =====================================================
# PostgreSQL Connection for OverInsur (ovwr) Platform
# Strategy: Use existing ai-saas-postgres container
# Table Naming: All tables use 'ovwr_' prefix to distinguish from existing projects
# =====================================================

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=ai_saas

# Drizzle ORM Connection String
DRIZZLE_URL="postgresql://postgres:postgres@localhost:5432/ai_saas"

# Note: All ovwr_ prefixed tables are created in the 'public' schema
# of the existing ai_saas database.
