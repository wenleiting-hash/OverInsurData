# Template only - copy to .env.development and fill in your own values.
#   copy: .env.development.example -> .env.development
# Holds PostgreSQL credentials for drizzle migrations; git-ignored, never commit.

# =====================================================
# PostgreSQL Connection for OverInsur (ovwr) Platform
# Strategy: Use existing ai-saas-postgres container
# Table Naming: All tables use 'ovwr_' prefix to distinguish from existing projects
# =====================================================

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=<replace-with-your-own-value>
PGDATABASE=ai_saas

# Drizzle ORM Connection String
DRIZZLE_URL=postgresql://<user>:<password>@<host>:<port>/<database>

# Note: All ovwr_ prefixed tables are created in the 'public' schema
# of the existing ai_saas database.
