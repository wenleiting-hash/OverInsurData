{
  "name": "insurance-platform",
  "version": "2.0.0",
  "private": true,
  "description": "海外保险数字化平台 V2.0（PostgreSQL 15 + Drizzle ORM）",
  "scripts": {
    "dev:carrier": "pnpm --filter web-carrier-admin dev",
    "dev:channel": "pnpm --filter web-channel-admin dev",
    "build:carrier": "pnpm --filter web-carrier-admin build",
    "build:channel": "pnpm --filter web-channel-admin build",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"apps/**/src/**/*.{ts,tsx}\" \"packages/**/src/**/*.ts\"",
    "format:check": "prettier --check \"apps/**/src/**/*.{ts,tsx}\" \"packages/**/src/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.15.0"
  },
  "packageManager": "pnpm@8.15.0",
  "dependencies": {
    "@overinsur/domain-models": "workspace:^"
  }
}
