# ==========================================================================
# carrier-service 环境变量模板（V1.0.16 workOS 集成）
# 复制为 .env 并填入真实值；生产环境通过 PM2/systemd 注入
# ==========================================================================

# ---------- 数据库 ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=overinsur_db
DB_USER=postgres
DB_PASSWORD=
DATABASE_URL=postgresql://postgres:@localhost:5432/overinsur_db

# ---------- JWT ----------
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ---------- V1.0.16 workOS 集成 ----------
# 主密钥：base64 编码的 32 字节，用于加密 appSecret；生产必填，未配置时降级用 JWT_SECRET（仅 dev）
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_MASTER_KEY=

# W1 接口：workOS 单点登录后端换发地址
WORKOS_USERINFO_URL=
WORKOS_CLIENT_ID=
WORKOS_CLIENT_SECRET=

# W1 联调模式：1=模拟器追加 &mock_user=base64(json)，后端绕过真实 W1 调用
WORKOS_MOCK=1

# workOS 登录入口（前端按钮跳转目标）
WORKOS_LOGIN_URL=

# workOS 出口网段白名单（CIDR，逗号分隔；生产必填）
WORKOS_EGRESS_CIDR=
