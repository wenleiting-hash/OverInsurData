# Template only - copy to the real file name and fill in your own values.
# The real file is git-ignored and must never be committed.
#   copy: .env.example -> .env

# Server Configuration
NODE_ENV=development
PORT=8080

# Database Configuration (OVERINSURDATA container - port 5433)
DB_HOST=localhost
DB_PORT=5433
DB_USER=overinsur
DB_PASSWORD=<replace-with-your-own-value>
DB_NAME=overinsur_db

# JWT Configuration
JWT_SECRET=<replace-with-your-own-value>
JWT_REFRESH_SECRET=<replace-with-your-own-value>
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d

# CORS (comma-separated whitelist)
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# Swagger Documentation
SWAGGER_ENABLED=true
SWAGGER_PATH=/api/docs
