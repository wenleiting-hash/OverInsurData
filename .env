# Server Configuration
NODE_ENV=development
PORT=8080

# Database Configuration (OVERINSURDATA container - port 5433)
DB_HOST=localhost
DB_PORT=5433
DB_USER=overinsur
DB_PASSWORD=overinsur123
DB_NAME=overinsur_db

# JWT Configuration
JWT_SECRET=overinsur-jwt-secret-change-in-production-2026
JWT_REFRESH_SECRET=overinsur-refresh-secret-change-in-production-2026
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d

# CORS (comma-separated whitelist)
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# Swagger Documentation
SWAGGER_ENABLED=true
SWAGGER_PATH=/api/docs
